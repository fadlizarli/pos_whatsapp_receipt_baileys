<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('button-container')]" position="inside">
            <button class="btn btn-success btn-lg wa-send-btn" t-on-click="onClickSendWhatsApp">
                <i class="fa fa-whatsapp me-1"/> Kirim via WhatsApp
            </button>
        </xpath>
    </t>

    <t t-name="pos_whatsapp_receipt_baileys.WhatsAppDialog" owl="1">
        <Dialog title="title" t-on-dialog-closed="onCancel">
            <div class="p-4">
                <p class="mb-2 fw-bold">Nomor WhatsApp pelanggan:</p>
                <input
                    t-ref="phoneInput"
                    type="tel"
                    class="form-control form-control-lg"
                    t-model="state.phone"
                    placeholder="08xxx atau 628xxx"
                />
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary me-2" t-on-click="onCancel">Batal</button>
                <button class="btn btn-success" t-on-click="onConfirm">
                    <i class="fa fa-paper-plane me-1"/> Kirim
                </button>
            </t>
        </Dialog>
    </t>

</templates>
